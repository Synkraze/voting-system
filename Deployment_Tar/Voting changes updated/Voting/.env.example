# Campus Election — config template. Copy to .env and set real secrets:
#   cp .env.example .env
# Generate strong keys:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

OPERATOR_KEY=change-me-operator
ADMIN_KEY=change-me-admin
PORT=3000
DB_FILE=election.db

# Optional paths. Uploads default to an uploads folder beside DB_FILE.
# KEY_DIR=keys
# UPLOAD_DIR=uploads

# --- Ballot-by-email (SMTP) ---
# Needed only if you use Admin -> "Email ballots". Students receive a one-time
# magic link to vote remotely. BASE_URL is the public address of THIS server
# (links are built as ${BASE_URL}/ballot.html?token=...). Must be https in prod.
# BASE_URL=https://vote.yourcollege.edu
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465, false for 587 (STARTTLS)
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Election Office <elections@yourcollege.edu>"
