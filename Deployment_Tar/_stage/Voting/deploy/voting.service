# systemd unit for the Campus Election server.
# Install to /etc/systemd/system/voting.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now voting
#   sudo systemctl status voting
#   journalctl -u voting -f        # live logs
#
# Assumes the app lives in /opt/voting, owned by a dedicated 'voting' user,
# with .env present there and Node installed at /usr/bin/node.

[Unit]
Description=Campus Election voting server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voting
Group=voting
WorkingDirectory=/opt/voting
ExecStart=/usr/bin/node --env-file=.env src/server.js
Restart=on-failure
RestartSec=3
# Keep the signing key + uploads inside the app dir; lock everything else down.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
