# Campus Election — config template. Copy to .env and set REAL values:
#   cp .env.example .env
# Never commit the real .env. Rotate any secret that has been shared or committed.

# --- Core ---
PORT=3000
# Managed Postgres (Supabase/RDS/Render). Password is embedded in the URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional connection-pool size (default 10).
# PG_POOL_MAX=10

# --- First admin account (seeded only when no admin exists yet) ---
ADMIN_USER=election-officer
ADMIN_PASS=change-me-to-a-long-random-passphrase

# --- Signing key (ed25519) ---
# Generate with: npm run keygen
# Disk deploys: the private key is written to KEY_DIR/server_ed25519.pem.
# KEY_DIR=keys
# Serverless/paste-in deploys: set the private key PEM directly and skip the file.
# PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: where resized candidate photos are stored (default ./uploads).
# UPLOAD_DIR=uploads

# --- Voter one-time codes (SMTP) ---
# Required for voters to receive their login code. Without SMTP, /voter/request-otp
# refuses up front.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
SMTP_FROM="Election Office <elections@yourcollege.edu>"
